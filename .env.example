# Contact form delivery (Resend)
# Create a key at https://resend.com and verify a sending domain.
RESEND_API_KEY=
CONTACT_TO_EMAIL=arrisedigital@gmail.com
CONTACT_FROM_EMAIL=Arrise Digital <hello@your-verified-domain.com>

# Optional: forward a short notification to Slack/Discord/Zapier
CONTACT_WEBHOOK_URL=

# Canonical production URL
NEXT_PUBLIC_SITE_URL=https://arrisedigital.vercel.app

# Supabase
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: never expose this to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase storage bucket name for images
NEXT_PUBLIC_SUPABASE_IMAGES_BUCKET=images
